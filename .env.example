# Enquiry delivery. See docs/ENQUIRY_SETUP.md.
# Copy to .env.local for local work. Set in Vercel for Production and Preview.
# Each channel is switched on by its own keys. An enquiry counts as delivered when
# at least one channel confirms it. With no channel set, every form shows
# "We could not send this" and nothing is reported as sent.

# Channel 1: Google Sheet (Apps Script web app). The secret is optional.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Channel 2: Telegram. Token from @BotFather; chat id of the group or person
# that should get every enquiry. Several chat ids can be separated by commas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
